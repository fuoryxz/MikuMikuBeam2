# =============================================================================
# c2-framework — example configuration
# =============================================================================
# Copy to .env and fill in:
#   cp .env.example .env
#   chmod 600 .env
#
# Generate safe values:
#   python3 tug.py genpsk --out .env --force
#   python3 tug.py checkpsk --env-file .env
# =============================================================================


# -----------------------------------------------------------------------------
# PSK (Pre-Shared Key) — required
# -----------------------------------------------------------------------------
# 64 hex chars (32 bytes). Used for HMAC-SHA256 on every frame.
# Generate: python3 -c "import os;print(os.urandom(32).hex())"
# DO NOT commit to git. DO NOT use default values.
C2_PSK=


# -----------------------------------------------------------------------------
# PSK rotation (optional)
# -----------------------------------------------------------------------------
# Previous key — accepted by server and clients during rotation.
# Flow: C2_PSK=new, C2_PSK_PREV=old → all bots reconnect →
#       remove C2_PSK_PREV after N hours.
C2_PSK_PREV=


# -----------------------------------------------------------------------------
# UI (web panel)
# -----------------------------------------------------------------------------
# Password to log into the panel. Empty = no auth (localhost only).
C2_UI_PASSWORD=

# Secret for signing tokens (HMAC). If unset — generated at startup,
# but tokens are invalidated on restart. Set explicitly for production:
#   python3 -c "import os;print(os.urandom(32).hex())"
C2_UI_SECRET=


# -----------------------------------------------------------------------------
# UI (optional)
# -----------------------------------------------------------------------------
# Audio URL for the "Start Miku Beam" button. Empty = default tenor.com GIF.
C2_AUDIO_URL=

# Hide PSK from startup output (1 = hide).
C2_QUIET_PSK=0


# -----------------------------------------------------------------------------
# Ports (used by tug.py, not server.py — server.py takes them from argv)
# -----------------------------------------------------------------------------
# C2 TCP port (clients connect here).
C2_PORT=4444

# UI HTTP port (browser opens http://host:UI_PORT/).
UI_PORT=8080


# -----------------------------------------------------------------------------
# Paths (optional)
# -----------------------------------------------------------------------------
# File with known bots (persistence across server restarts).
# Default: bots.json in cwd.
C2_BOTS_FILE=bots.json


# =============================================================================
# Example values (DO NOT use in production):
# =============================================================================
# C2_PSK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# C2_PSK_PREV=
# C2_UI_PASSWORD=change-me-please
# C2_UI_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
# C2_AUDIO_URL=
# C2_QUIET_PSK=0
# C2_PORT=4444
# UI_PORT=8080
# C2_BOTS_FILE=bots.json
