# =============================================================================
# c2-framework — .gitignore
# =============================================================================
# Локальные переменные окружения (PSK, пароли, секреты)
# =============================================================================
.env
.env.local
.env.*.local

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Тесты / покрытие
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Виртуальные окружения
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# =============================================================================
# C / C++ (CMake)
# =============================================================================
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/
Makefile
install_manifest.txt
compile_commands.json

# Артефакты компиляции
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Отладка
*.pdb
*.ilk
*.idb
*.exp
*.map

# =============================================================================
# Runtime-данные C2
# =============================================================================
bots.json
bots.json.*
server.log
fakes.log
*.log
!docs/*.log
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# =============================================================================
# macOS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# =============================================================================
# Windows
# =============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# Linux
# =============================================================================
*~
.directory
.Trash-*
.nfs*

# =============================================================================
# IDE / Редакторы
# =============================================================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (CLion, PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Vim
*.swp
*.swo
.*.sw?

# Emacs
*~
\#*\#
.\#*

# Sublime
*.sublime-workspace
*.sublime-project

# =============================================================================
# Прочее
# =============================================================================
# Упаковка релизов
dist/
*.tar.gz
*.zip
*.tar
*.rar
*.7z

# Jupyter
.ipynb_checkpoints/

# Документация (генерируемая)
docs/_build/
site/

# =============================================================================
# Исключения (что НЕ игнорировать)
# =============================================================================
!.env.example
!.gitignore
!README.md
!LICENSE
!CMakeLists.txt
